{
  "info": {
    "name": "Uplinkr API (v1)",
    "description": "Collection for current Uplinkr API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "api_prefix", "value": "/api/v1" },
    { "key": "api_key", "value": "replace-me" },
    { "key": "project", "value": "my-project" },
    { "key": "probe_id", "value": "replace-with-probe-id" },
    { "key": "result_id", "value": "replace-with-result-id" }
  ],
  "item": [
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects",
          "request": { "method": "GET", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/projects" }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"project\": \"{{project}}\",\n  \"label\": \"My Project\",\n  \"description\": \"Created via API\"\n}" },
            "url": "{{base_url}}{{api_prefix}}/projects"
          }
        },
        {
          "name": "Get Project",
          "request": { "method": "GET", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/projects/{{project}}" }
        },
        {
          "name": "Patch Project",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"label\": \"Renamed Project\",\n  \"status\": \"enabled\"\n}" },
            "url": "{{base_url}}{{api_prefix}}/projects/{{project}}"
          }
        },
        {
          "name": "Delete Project",
          "request": { "method": "DELETE", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/projects/{{project}}" }
        }
      ]
    },
    {
      "name": "Probes",
      "item": [
        {
          "name": "List All Probes",
          "request": { "method": "GET", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/probes" }
        },
        {
          "name": "List Project Probes",
          "request": { "method": "GET", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/projects/{{project}}/probes" }
        },
        {
          "name": "Create Project Probe",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://example.com/health\",\n  \"method\": \"GET\",\n  \"headers\": [\"Accept: application/json\"],\n  \"latency\": 1500\n}" },
            "url": "{{base_url}}{{api_prefix}}/projects/{{project}}/probes"
          }
        },
        {
          "name": "Get Project Probe",
          "request": { "method": "GET", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/projects/{{project}}/probes/{{probe_id}}" }
        },
        {
          "name": "Patch Project Probe",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"method\": \"GET\",\n  \"latency\": 1000\n}" },
            "url": "{{base_url}}{{api_prefix}}/projects/{{project}}/probes/{{probe_id}}"
          }
        },
        {
          "name": "Delete Project Probe",
          "request": { "method": "DELETE", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/projects/{{project}}/probes/{{probe_id}}" }
        }
      ]
    },
    {
      "name": "Results",
      "item": [
        {
          "name": "List All Results",
          "request": { "method": "GET", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/results?limit=100" }
        },
        {
          "name": "List Project Results",
          "request": { "method": "GET", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/projects/{{project}}/results?limit=100" }
        },
        {
          "name": "Execute Project Probe (Create Result)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://example.com/health\",\n  \"method\": \"GET\",\n  \"headers\": {\n    \"Accept\": \"application/json\"\n  },\n  \"latency\": 1500\n}" },
            "url": "{{base_url}}{{api_prefix}}/projects/{{project}}/results"
          }
        },
        {
          "name": "Get Result",
          "request": { "method": "GET", "header": [{ "key": "X-Uplinkr-Api-Key", "value": "{{api_key}}" }], "url": "{{base_url}}{{api_prefix}}/results/{{result_id}}" }
        }
      ]
    }
  ]
}
