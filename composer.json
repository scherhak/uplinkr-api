{
  "name": "scherhak/uplinkr-api",
  "description": "REST API package for Uplinkr monitoring.",
  "keywords": [
    "api",
    "rest",
    "laravel",
    "monitoring",
    "uptime",
    "probe",
    "status"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://uplinkr.dev",
  "authors": [
    {
      "name": "Sascha Scherhak",
      "email": "sascha@uplinkr.dev"
    }
  ],
  "support": {
    "source": "https://github.com/scherhak/uplinkr-api",
    "issues": "https://github.com/scherhak/uplinkr-api/issues",
    "docs": "https://uplinkr.dev/docs"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/scherhak/uplinkr"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/http": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/support": "^12.0",
    "scherhak/uplinkr": "dev-main"
  },
  "config": {
    "platform": {
      "php": "8.4.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "UplinkrApi\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "UplinkrApi\\UplinkrApiServiceProvider"
      ]
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "UplinkrApi\\Tests\\": "tests/"
    }
  }
}
